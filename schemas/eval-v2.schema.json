{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/domehahn/skcr/schemas/eval-v2.schema.json",
  "title": "skcr Evaluation Source v2",
  "type": "object",
  "required": ["schema_version", "scenarios"],
  "properties": {
    "schema_version": {"const": "2"},
    "scenarios": {
      "type": "array",
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "scenario": {
      "type": "object",
      "required": ["id", "description", "type", "input", "context", "environment", "tools", "expect", "goal_refs", "invariant_refs", "containment"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "description": {"type": "string", "minLength": 1},
        "type": {"enum": ["behavioral", "adversarial"]},
        "input": {
          "type": "object",
          "required": ["message"],
          "properties": {"message": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        },
        "context": {"type": "object"},
        "environment": {"type": "object"},
        "tools": {
          "type": "object",
          "required": ["available"],
          "properties": {"available": {"$ref": "#/$defs/stringList"}},
          "additionalProperties": false
        },
        "expect": {
          "type": "object",
          "required": ["required", "allowed", "forbidden", "forbidden_capabilities", "arguments", "output_properties", "assertions"],
          "properties": {
            "required": {"$ref": "#/$defs/stringList"},
            "allowed": {"$ref": "#/$defs/stringList"},
            "forbidden": {"$ref": "#/$defs/stringList"},
            "forbidden_capabilities": {"$ref": "#/$defs/stringList"},
            "arguments": {"type": "object", "additionalProperties": {"type": "string"}},
            "output_properties": {"type": "array", "items": {"enum": ["non_empty", "json", "no_secrets"]}, "uniqueItems": true},
            "assertions": {"type": "array", "items": {"enum": ["no_external_side_effects", "no_errors", "no_forbidden_capabilities", "containment_compliant"]}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "goal_refs": {
          "type": "object",
          "required": ["must_satisfy"],
          "properties": {"must_satisfy": {"$ref": "#/$defs/stringList"}},
          "additionalProperties": false
        },
        "invariant_refs": {
          "type": "object",
          "required": ["must_hold"],
          "properties": {"must_hold": {"$ref": "#/$defs/stringList"}},
          "additionalProperties": false
        },
        "attack": {
          "type": "object",
          "required": ["category"],
          "properties": {"category": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        },
        "containment": {
          "type": "object",
          "required": ["required", "allowed_targets", "require_enforcement", "require_native_isolation"],
          "properties": {
            "required": {"type": "boolean"},
            "allowed_targets": {
              "type": "object",
              "propertyNames": {"type": "string", "minLength": 1},
              "additionalProperties": {"$ref": "#/$defs/stringList"}
            },
            "require_enforcement": {"type": "boolean"},
            "require_native_isolation": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      },
      "allOf": [{
        "if": {"properties": {"type": {"const": "adversarial"}}, "required": ["type"]},
        "then": {"required": ["attack"]}
      }],
      "additionalProperties": false
    }
  }
}
